#!/usr/bin/env bash
# Checks staged changes only. Bypass (emergency): git commit --no-verify
set -uo pipefail
PATH="$PWD/node_modules/.bin:$PATH" # hooks run from repo root
fail=0
ts=
err() { echo "pre-commit: $*" >&2; fail=1; }

# Whitespace errors + leftover conflict markers.
git --no-pager diff --cached --check || err "whitespace errors / conflict markers"

mapfile -t files < <(git diff --cached --name-only --diff-filter=ACMR)

for f in "${files[@]}"; do
    # Large files belong in LFS/artifacts, not git.
    size=$(git cat-file -s ":$f")
    ((size > 1048576)) && err "$f is $((size / 1024)) KiB (>1 MiB)"

    case "$f" in
    *.c | *.cc | *.cpp | *.h | *.hpp)
        # Check the staged blob, not the working tree.
        git show ":$f" | clang-format --dry-run --Werror --assume-filename="$f" \
            2>/dev/null || err "$f not clang-formatted (run: clang-format -i $f)"
        ;;
    *.py)
        git show ":$f" | ruff check --stdin-filename "$f" - >&2 ||
            err "$f fails ruff check"
        git show ":$f" | ruff format --check --stdin-filename "$f" - >/dev/null ||
            err "$f not ruff-formatted (run: ruff format $f)"
        ;;
    package-lock.json) ;;
    *.ts | *.json | *.html)
        blob=$(git show ":$f")
        [[ "$blob" == "$(printf '%s' "$blob" | prettier --stdin-filepath "$f" 2>/dev/null)" ]] ||
            err "$f not prettier-formatted (run: npx prettier --write -- $f)"
        [[ "$f" == *.ts ]] && ts=1
        ;;
    *.sh | .githooks/*)
        command -v shellcheck >/dev/null &&
            { git show ":$f" | shellcheck - || err "$f fails shellcheck"; }
        ;;
    esac
done

# ponytail: type-checks working tree, not staged blobs; fine unless you stage partial TS edits.
[[ -n "${ts:-}" ]] && { tsc --noEmit >&2 || err "TypeScript type errors"; }

if command -v betterleaks >/dev/null; then
    betterleaks git --pre-commit --staged --redact --verbose --legacy-print --no-banner --log-level warn ||
        err "betterleaks found secrets (false positive? add fingerprint to .betterleaksignore)"
else
    err "betterleaks not installed, see README"
fi

((fail)) && echo "pre-commit: commit blocked" >&2
exit "$fail"
