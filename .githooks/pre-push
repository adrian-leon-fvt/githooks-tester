#!/usr/bin/env bash
# Runs before anything leaves the machine. Bypass (emergency): git push --no-verify
set -euo pipefail
protected='refs/heads/main'
zero=0000000000000000000000000000000000000000

while read -r _ local_sha remote_ref remote_sha; do
    [[ "$local_sha" == "$zero" ]] && continue # branch delete
    if [[ "$remote_ref" == "$protected" ]]; then
        echo "pre-push: direct push to main blocked, open a PR" >&2
        exit 1
    fi
    range=$local_sha
    [[ "$remote_sha" != "$zero" ]] && range="$remote_sha..$local_sha"
    if git log --format=%s "$range" --not --remotes | grep -qE '^(fixup!|squash!|WIP|wip)'; then
        echo "pre-push: fixup/WIP commits in push, squash first" >&2
        exit 1
    fi
done

make test
