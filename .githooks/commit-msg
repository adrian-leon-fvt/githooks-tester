#!/usr/bin/env bash
# Enforce conventional commits: type(scope)!: subject
set -euo pipefail
subject=$(head -n1 "$1")
[[ "$subject" =~ ^(Merge|Revert|fixup!|squash!) ]] && exit 0
re='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._-]+\))?!?: .{1,72}$'
if ! [[ "$subject" =~ $re ]]; then
    echo "commit-msg: not a conventional commit: '$subject'" >&2
    echo "  expected: type(scope)?: subject   e.g. 'feat(can): add BMS_STATUS decode'" >&2
    exit 1
fi
