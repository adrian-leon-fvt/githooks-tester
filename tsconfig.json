{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "rewriteRelativeImportExtensions": true,
    "rootDir": "web/src",
    "outDir": "web/dist"
  },
  "include": ["web/src"]
}
